---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StrisciaLoghi from '../components/StrisciaLoghi.astro';
import Divisioni from '../components/Divisioni.astro';
import PerChiLavoriamo from '../components/PerChiLavoriamo.astro';
---

<Base>
  <Header />
  <main>
    <!-- Prima schermata: hero + loghi riempiono esattamente lo schermo (sotto l'header),
         la striscia dei loghi è l'ultima cosa visibile in basso. Scelta di Enrico (24/11). -->
    <div class="apertura">
      <Hero />
      <StrisciaLoghi />
    </div>
    <Divisioni />
    <PerChiLavoriamo />
  </main>
</Base>

<script>
  import '../scripts/animazioni.js';
</script>

<style>
  @media (min-width: 769px) {
    .apertura {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - 70 * var(--u-ui)); /* 70 = altezza dell'header */
    }
    .apertura > :global(.hero) { flex: 1 0 auto; padding-block: min(var(--space-16), 4svh); } /* schermi bassi: i loghi restano dentro */
    .apertura > :global(.clienti) { padding-bottom: var(--space-10); }
  }
</style>
